# DFA VISUALIZER APPLICATION BASE ID - THIS IS FIXED FOR ALL DFA VISUALIZER APPLICATIONS
APP_BASE_ID=DTK_VIZ
NEXT_PUBLIC_APP_BASE_ID=DTK_VIZ

# DFA VISUALIZER ADPTATION APP ID - THIS SHOULD BE UNIQUE FOR EACH ADPTATION OF THE DFA VISUALIZER APPLICATION
APP_ID=DFATSTVIZ
NEXT_PUBLIC_APP_ID=DFATSTVIZ

# Application Base URL (used for Core API and DFA search). Must be reachable from server and browser.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# API base URL (used for Core API and DFA search). Must be reachable from server and browser.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# When "true": browser → /api/proxy (server signs with API_SIGNING_PRIVATE_KEY).
# When "false": browser → API directly (client signs with NEXT_PUBLIC_* keys below).
NEXT_PUBLIC_ENABLE_API_PROXY=true

# API PROXY URL IF ENABLE_API_PROXY IS TRUE. base URL (used for Core API and DFA search). Must be reachable from server and browser.
NEXT_PUBLIC_API_PROXY_URL=http://fastapi-service

# API KEY FOR THE DFA VISUALIZER APPLICATION
NEXT_PUBLIC_API_KEY=dfa6_viz_fed_app

# Direct mode (proxy off): gate + Ed25519 private key (baked into client bundle at build)
# Base64 PKCS#8 Ed25519 private key — obtain from your secret store; never commit a real value.
NEXT_PUBLIC_API_SIGNATURE=1234567890
NEXT_PUBLIC_API_SIGNING_PRIVATE_KEY=

# Proxy mode (proxy on): server-only signing key in K8s Secret / local .env (not NEXT_PUBLIC_*)
API_SIGNING_PRIVATE_KEY=

# PWA Configuration
# --------------------------------------------

# Enable/Disable Progressive Web App features
# When 'false': PWA features are completely disabled (no service worker, no offline mode)
# Default: true (enabled)
NEXT_PUBLIC_PWA_ENABLED=true

# Enable/Disable PWA Runtime Caching
# When 'false': Service Worker runs without caching (slower but always fresh data)
# Default: true (enabled)
NEXT_PUBLIC_CACHE_ENABLED=true
