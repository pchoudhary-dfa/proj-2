# DFA VISUALIZER APPLICATION BASE ID - THIS IS FIXED FOR ALL DFA VISUALIZER APPLICATIONS
APP_BASE_ID=DTK_DM
NEXT_PUBLIC_APP_BASE_ID=DTK_DM

# DFA VISUALIZER ADPTATION APP ID - THIS SHOULD BE UNIQUE FOR EACH ADPTATION OF THE DFA VISUALIZER APPLICATION
APP_ID=DFATSTDM
NEXT_PUBLIC_APP_ID=DFATSTDM

# Application Base URL (used for Core API and DFA search). Must be reachable from server and browser.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# API base URL (toolkit). Used by the browser for non-proxied assets and as the default server-side API base.
NEXT_PUBLIC_API_BASE_URL=https://test.api.dfa6.dataforall.org

# Server-only: FastAPI base URL for Next.js Route Handlers (`/api/backend`, `/api/auth/*`). Defaults to NEXT_PUBLIC_API_BASE_URL.
# DFA_TOOLKIT_INTERNAL_API_URL=http://127.0.0.1:8000

# Deprecated: browser API traffic uses same-origin `/api/backend` + `/api/auth/*` regardless.
NEXT_PUBLIC_ENABLE_API_PROXY=false

# Legacy docker service hostname when using old `/api/proxy` setups.
NEXT_PUBLIC_API_PROXY_URL=http://fastapi-service

# API KEY FOR THE DFA DATA MANAGER FED CLIENT (browser / default BFF identity)
NEXT_PUBLIC_API_KEY=dfa_dm_fed_app

# API SIGNATURE FOR THE DFA VISUALIZER APPLICATION
NEXT_PUBLIC_API_SIGNATURE=1234567890

# Grid inline-edit ghost autocomplete from existing row values (NIS.Cost-style). Omit or set to anything other than "true" to disable.
# NEXT_PUBLIC_ENABLE_AUTO_SUGGESTIONS=true

# Indicator page add-row subgroup GID (locked/disabled in add-IUS grid row).
NEXT_PUBLIC_DEFAULT_IUS_SUBGROUP_GID=TOTAL

# Ed25519 private key for BFF -> toolkit signing (server-only)
# Base64 PKCS#8 — obtain from your secret store; never commit a real value.
DM_API_SIGNING_PRIVATE_KEY=

# PWA Configuration
# --------------------------------------------

# Enable/Disable Progressive Web App features (service worker + runtime caching)
# When 'false': PWA features are completely disabled (no service worker, no offline mode)
# Default: true (enabled)
NEXT_PUBLIC_PWA_ENABLED=true