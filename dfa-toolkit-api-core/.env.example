# Copy this file to .env and fill in all required values.
# All configuration is driven from this single root .env file.

# =============================================================================
# Project Information
# =============================================================================
PROJECT_NAME=DFA Toolkit API Core
# Optional fallback only — canonical version is the latest entry in CHANGELOG.md (see scripts/bump_changelog.py)
VERSION=0.1.0
DESCRIPTION=FastAPI Gateway for DFA Toolkit
API_V1_STR=/api/v1

# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=8000
DEBUG=false

# =============================================================================
# Environment
# =============================================================================
# Options: development | staging | production
ENVIRONMENT=development

# =============================================================================
# CORS Configuration
# =============================================================================
# JSON format:        CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# Comma-separated:    CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# =============================================================================
# Database Configuration (MySQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dfa_toolkit_core_20265
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Legacy full URL (optional; constructed from the above components when empty)
DATABASE_URL=

# =============================================================================
# Security Configuration
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-set-a-random-secret-in-your-local-env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional: key for encrypting stored data warehouse passwords.
# When empty, derived from SECRET_KEY.
PASSWORD_ENCRYPTION_KEY=

# =============================================================================
# JWT Configuration
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-only-set-a-random-jwt-secret-in-your-local-env
JWT_ALGORITHM=HS256
# Forgot-password reset link JWT TTL (minutes)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# App Client / Signature Verification
# =============================================================================
# Default app key used when no X-Api-Key is specified in internal calls.
DEFAULT_APP_KEY=DFA_DM
# =============================================================================
# Seed — application and API client keys
# Override when your deployment uses different app_key / api_key values.
# All seed scripts read these; a single change here propagates everywhere.
DFA_DM_APP_KEY=DFA_DM
DFA_VIZ_APP_KEY=DFA_VIZ
DFA_DASH_APP_KEY=DFA_DASH
DFA_DM_FED_APP_API_KEY=dfa_dm_fed_app
DFA_VIZ_FED_APP_API_KEY=dfa_viz_fed_app
DFA_DASH_FED_APP_API_KEY=dfa_dash_fed_app
# Development Swagger (/docs, ENVIRONMENT=development) auto-signs app-client requests with
# these Ed25519 PKCS#8 private keys (base64 or PEM). Empty = no auto-signing for that client.
# Get values from the team secret store; never commit them.
DFA_DM_API_SIGNING_PRIVATE_KEY=
DFA_VIZ_API_SIGNING_PRIVATE_KEY=
DFA_DASH_API_SIGNING_PRIVATE_KEY=
# Maps app_key -> role_code for auto-assigning a default role on user registration.
# JSON format. Leave empty or omit to disable auto-assignment for all app_keys.
DEFAULT_ROLE_MAP={"DFA_VIZ": "DFA_PUBLIC"}
# When true (default): enforce X-App-Key lookup, ACTIVE status, auth_method guard, and Signature verification.
# Set to false during local dev or internal testing to skip all app-client validation.
ENABLE_APP_CLIENT_AUTH=true
# When true (default): enforce HMAC/RSA signature verification on app-client requests.
# Set to false during local dev or FED onboarding to skip signature checks only.
# Only takes effect when ENABLE_APP_CLIENT_AUTH=true.
ENABLE_SIGNATURE_VERIFICATION=false

# =============================================================================
# System User (seed / Swagger demo credentials)
# =============================================================================
SYSTEM_USER_ID=1
SYSTEM_USER_USERNAME=admin
# Set a strong password before running the seed scripts.
SYSTEM_USER_PASSWORD=change-me
SYSTEM_USER_EMAIL=admin@example.com
SYSTEM_USER_FIRST_NAME=DM
SYSTEM_USER_LAST_NAME=Super Admin

# =============================================================================
# DFA Visualizer Super-Admin User (seeded into DFA_VIZ application)
# =============================================================================
VIZ_USER_USERNAME=viz_admin
VIZ_USER_PASSWORD=change-me
VIZ_USER_EMAIL=viz_admin@example.com
VIZ_USER_FIRST_NAME=VIZ
VIZ_USER_LAST_NAME=Super Admin

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# Comma-separated log level names (uppercase) to persist to logs_server_error via log_event
# (empty = no DB rows). Must match the level names produced by resolve_log_level in code:
#   HTTP 5xx -> ERROR; 401 / 403 / 429 -> WARNING; other 4xx -> INFO; 3xx / 2xx -> INFO.
# log_background_incident uses the same mapping from its status_code (default 500 -> ERROR).
# Example: DB_LOG_LEVELS=ERROR
# Example: DB_LOG_LEVELS=ERROR,WARNING  (also persist WARNING-tier denials)
DB_LOG_LEVELS=ERROR
# Max bytes of JSON request body buffered by RequestContextMiddleware and persisted to
# logs_server_error.request_body. Bodies larger than this are skipped (no buffering, no
# log column) so streaming uploads stay zero-copy.
LOG_REQ_BODY_MAX_BYTES=8192

# =============================================================================
# Language Configuration
# =============================================================================
# Comma-separated list of allowed language codes.
# Example: AVAILABLE_LANGUAGES=en,fr,ar,es,ru
AVAILABLE_LANGUAGES=en

# =============================================================================
# API Path Configuration
# =============================================================================
DATAWAREHOUSES_BASE_PATH=dw

# =============================================================================
# Redis Cache Configuration
# =============================================================================
# Redis URL for indicator-response caching (optional; empty = no caching).
# Example: REDIS_URL=redis://localhost:6379/0
REDIS_URL=
CACHE_INDICATOR_TTL_SECONDS=300
# Prefix for Redis cache keys used by DFA Mailer.
REDIS_KEY_PREFIX=DFA

# =============================================================================
# Indicator Response Configuration
# =============================================================================
# Comma-separated list of fields to include in indicator responses.
# Empty = return all fields.
# Example: INDICATOR_RESPONSE_FIELDS=indicator_nid,indicator_name,indicator_gid,indicator_info
# Available fields: indicator_nid, indicator_name, indicator_gid, indicator_info,
#                   indicator_global, short_name, keywords, indicator_order, data_exist,
#                   highisgood, locale, unit_nid, subgroup_val_nid, default_subgroup_nid,
#                   ic_nid, metadata
INDICATOR_RESPONSE_FIELDS=

# =============================================================================
# GID Separator (IUS composite key)
# =============================================================================
# Separator used to build composite IUS GID: i_gid + sep + u_gid + sep + s_gid.
# Example: IUS_GID_SEPARATOR=|  ->  IND_001|UNIT_001|SG_001
IUS_GID_SEPARATOR=|

# =============================================================================
# Data Warehouse System Subgroup
# =============================================================================

# GID of the subgroup category (OTHERS) under which the system subgroup lives (created if missing).
# Get registered in the system config table with given DW_ID (datawarehouse id from system_datawarehouse table).
DW_SYSTEM_SUBGROUP_CATG_OTHERS_GID=OTHERS
DW_SYSTEM_SUBGROUP_CATG_TOTAL_GID=TOTAL

# GID of the system subgroup (TOTAL) mapped to the TOTAL subgroup categegory
# Created on DW optimize and cannot be deleted via API.
# Get registered in the system config table with given DW_ID (datawarehouse id from system_datawarehouse table).
DEFAULT_SYSTEM_DW_SUBGROUP_GID=TOTAL

# =============================================================================
# Response Adaptation
# =============================================================================
# Empty or unset = internal field names (e.g. indicator_nid, indicator_name).
# "external"      = simplified/renamed keys (e.g. id, gid, name, description).
ADAPTATION=

# Optional path to db_tbl_cols_mapping.json (internal->external key mapping).
# Empty = uses apps/datawarehouse/config/db_tbl_cols_mapping.json
DB_TBL_COLS_MAPPING_PATH=

# =============================================================================
# Create API Response
# =============================================================================
# false (default): create endpoints return only nid and gid.
# true:            create endpoints return the full created record.
RETURN_FULL_RES_AFTER_CREATE=false

# =============================================================================
# Route Cache
# =============================================================================
# false: routes reload from DB on every request (dev/seeding only — impacts performance).
# true:  iam_resource_api routes are cached in memory after first load (recommended for production).
ENABLE_ROUTE_CACHE=true

# =============================================================================
# IAM — CRUD to HTTP method mapping
# =============================================================================
# Email / SMTP Configuration
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@dfa.example.com
SMTP_FROM_NAME=DFA Toolkit
# Fallback FED origin for DFA_DM emails when system_application_client.origin_url is empty
DFA_DM_FED_ORIGIN_URL=http://localhost:3000

# =============================================================================
# DFA Mailer Service Configuration
# =============================================================================
DFA_MAILER_API_PREFIX=/dfa-mailer
# Trailing slash on mailer collection routes (GET/POST /dfa-mailer/templates/, GET /dfa-mailer/logs/)
DFA_MAILER_TRAILING_SLASH=true
# Mail provider: "smtp" or "mailjet"
MAIL_PROVIDER=smtp
# Send mode: "auto" | "sync" | "async"
# With IS_BACKGROUND_ENABLED + BG_JOB_MQ_TYPE=DB + BG_JOB_POLLER_ENABLED + JOB_WORKER empty:
# - Set DFA_SEND_MODE=auto (or omit) so send_email uses system_bg_job_queue + in-process poller (dfa_send_email).
# - DFA_SEND_MODE=sync forces SMTP in the HTTP request (poller not used).
# OCI K8s env-config overlays use auto for DB-poller mail.
DFA_SEND_MODE=auto
# Comma-separated list of admin alert recipient emails (empty = no alerts).
ADMIN_ALERT_EMAILS=
ALERT_ON_ASYNC_FAILURE=true
# Pagination type: "offset" or "page"
DFA_PAGINATION_TYPE=offset
DFA_PAGE_SIZE=100
DFA_ENABLE_VERBOSE_LOGS=false

# =============================================================================
# Async email: JOB_WORKER=celery (Celery broker) or JOB_WORKER=db (system_bg_job_queue)
# =============================================================================
# celery = queue send_email_task on DFA_CELERY_* broker/queue (requires Celery worker).
# db     = insert job_type=dfa_send_email into system_bg_job_queue; requires BG_JOB_MQ_TYPE=DB,
#          BG_JOB_POLLER_ENABLED=true, and a running poller (FastAPI lifespan or dfa-mailer worker thread).
# With that triplet, leaving JOB_WORKER unset defaults it to db (same queue as other BG jobs).
JOB_WORKER=
DFA_CELERY_BROKER_URL=redis://localhost:6379/0
DFA_CELERY_RESULT_BACKEND=redis://localhost:6379/0
DFA_CELERY_QUEUE_NAME=dfa_mailer_service

# =============================================================================
# Celery (central worker: ISMRD tasks, etc. — apps.shared.config.celery_config)
# =============================================================================
# Broker URL (e.g. RabbitMQ amqp:// or Redis redis://localhost:6379/0)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
# Result backend (e.g. rpc:// or redis://localhost:6379/0)
CELERY_RESULT_BACKEND=rpc://
# Queue name for ISMRD tasks; if unset, default Celery queue "celery" is used
CELERY_QUEUE_NAME_ISMRD=dfa_dw_ismrd
# Queue name for subgroup update tasks; if unset, default Celery queue "celery" is used
CELERY_QUEUE_NAME_SUBGROUP_UPDATE=dfa_dw_subgroup_update
# Background job dispatch: CELERY = broker queue; DB = rows in system_bg_job_queue drained by the in-process asyncio poller (BG_JOB_POLLER_ENABLED must be true). Async email with JOB_WORKER=db uses the same table (dfa_send_email jobs).
BG_JOB_MQ_TYPE=CELERY
# When true and BG_JOB_MQ_TYPE=DB, FastAPI and the dfa-mailer Celery worker run an asyncio poller for system_bg_job_queue — including async email when JOB_WORKER=db (worker requires monolith apps.shared on PYTHONPATH)
BG_JOB_POLLER_ENABLED=false
# Seconds between poller ticks; keep modest (a typo like 7000 means ~2h between drains)
BG_JOB_POLL_INTERVAL_SEC=5
BG_JOB_POLL_BATCH_SIZE=10
# Seconds before a stuck "processing" row is reset to pending (0 = off)
BG_JOB_STALE_LEASE_SEC=1800

# =============================================================================
# Publish Mobile App
# =============================================================================
# Local directory where mobile ZIP packages are stored on disk
PUBLISH_MOBILE_FILES_DIR=./publish_mobile_data
# DML map API base URL (e.g. https://dfadml.dataforall.org/api/). Used to build map_url.
DML_API_BASE_URL=
CELERY_QUEUE_NAME_MOBILE_PACKAGE=celery
# When true, queue ISMRD update to Celery when over combination/IUS thresholds; when false, always run inline
IS_BACKGROUND_ENABLED=true
# Queue for mark-default-subgroup tasks (optional; default Celery queue "celery" if unset)
CELERY_QUEUE_NAME_DEFAULT_SUBGROUP=dfa_dw_default_subgroup
# Mark default subgroup: max IUS rows / distinct (indicator, unit) pairs for inline run; above = Celery when IS_BACKGROUND_ENABLED=true
DEFAULT_SUBGROUP_SYNC_MAX_IUS_ROWS=1000
DEFAULT_SUBGROUP_SYNC_MAX_IU_PAIRS=1000

# ---------------------------------------------------------------------------
# Parallel XLSX data-point export
# ---------------------------------------------------------------------------
# Max parallel subprocesses for data-points XLSX export (ProcessPoolExecutor, started at app boot).
# Each worker is recycled after one chunk (max_tasks_per_child=1) to avoid memory growth on repeat exports.
# Large exports split into up to EXPORT_POOL_SIZE Excel files (min 10k rows per file); a single part
# is returned as .xlsx directly; multiple parts are streamed as one ZIP. Row cap: DATA_POINTS_SYNC_EXPORT_MAX_ROWS.
#
# Tuning EXPORT_POOL_SIZE (per API pod):
#   1  — safest; ~1 Gi RAM limit or OOM during export; no parallel workers.
#   2  — 2 worker processes; ~1–1.5 Gi RAM, ~0.75–1 CPU; good for ~100k-row exports.
#   3–4 — only with ~2–3 Gi RAM and ~2 CPU; watch MySQL max_connections (each worker uses DB).
# Rule of thumb: pool_size <= floor((pod_memory_limit_MB - 500) / 300). One export uses up to
# EXPORT_POOL_SIZE workers at once; small exports (<10k rows) still produce a single file.
EXPORT_POOL_SIZE=2
# Hard cap on total matching rows for a synchronous export. Requests over this limit are rejected.
DATA_POINTS_SYNC_EXPORT_MAX_ROWS=500000

# ---------------------------------------------------------------------------
# Data-point import (XLSX/CSV round-trip)
# ---------------------------------------------------------------------------
# Row count above this queues batched jobs in system_bg_job_queue (shared request_id).
# Poll GET .../data-points/import-logs and datapoint_readiness until COMPLETED or FAILED.
# Set to 0 to always import synchronously in the HTTP request.
DATASET_IMPORT_BG_THRESHOLD=10000
# Hard cap: imports over this row count are rejected (narrow file or split uploads).
DATA_POINTS_SYNC_IMPORT_MAX_ROWS=50000

