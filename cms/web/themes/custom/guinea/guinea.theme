/**
 * Implements hook_views_pre_render() for the theme.
 *
 * Exposes selected page view result counts to JS.
 */
function guinea_views_pre_render(ViewExecutable $view) {
  $display_id = (string) ($view->current_display ?? '');
  if ($display_id === '' || !str_starts_with($display_id, 'page')) {
    return;
  }

  $count = (int) $view->total_rows;
  if (!isset($view->element['#attached']['drupalSettings']['guinea'])) {
    $view->element['#attached']['drupalSettings']['guinea'] = [];
  }

  if (in_array($view->id(), ['ressources', 'resources'], TRUE)) {
    $view->element['#attached']['drupalSettings']['guinea']['ressourcesResultCount'] = $count;
    $view->element['#attached']['library'][] = 'guinea/ressources-result-count';
    return;
  }

  // Use display path to avoid hard dependency on one specific view machine name.
  $path = trim((string) ($view->display_handler ? $view->display_handler->getOption('path') : ''), '/');
  if ($path === 'apprentissage') {
    $view->element['#attached']['drupalSettings']['guinea']['apprentissageResultCount'] = $count;
    $view->element['#attached']['library'][] = 'guinea/apprentissage-result-count';
  }
}

function guinea_theme_suggestions_page_alter(array &$suggestions, array $variables)
{
  // 404 and 403 template suggestions.
  $request = \Drupal::requestStack()->getCurrentRequest();
  $exception = $request->attributes->get('exception');
  if ($exception) {
    $status_code = $exception->getStatusCode();
    if ($status_code == 404 || $status_code == 403) {
      $suggestions[] = 'page__' . $status_code;
    }
  }

  // Checks for node pages and adds page URL alias-based template name.
  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    if ($node instanceof NodeInterface) {
      $suggestions[] = 'page__node__' . $node->bundle();
    }
    $current_path = \Drupal::service('path.current')->getPath();
    $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
    $clean_alias = str_replace('-', '', ltrim($alias, '/'));
    $suggestions[] = 'page__node__' . $clean_alias;
  }

  // Add template suggestions for user password pages.
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name == 'user.pass') {
    // Template file: page--user--password.html.twig
    $suggestions[] = 'page__user__password';
  }
  // Check for user reset form route (can be user.reset.form or user.reset)
  if ($route_name == 'user.reset.form' || $route_name == 'user.reset' || strpos($route_name, 'user.reset') !== false) {
    $suggestions[] = 'page__user__reset';
  }
  if ($route_name === 'user.logout.confirm') {
    $suggestions[] = 'page__user__logout__confirm';
  }
  if ($route_name === 'entity.user.edit_form') {
    $request = \Drupal::request();
    $token = $request->query->get('pass-reset-token');
    if ($token !== NULL && $token !== '') {
      $suggestions[] = 'page__user__password_reset';
    }
    else {
      $suggestions[] = 'page__user__edit';
    }
  }
  if ($route_name === 'entity.user.create_form') {
    $suggestions[] = 'page__admin__people__create';
  }
}



function guinea_preprocess_page(array &$variables)
{
  $site_config = \Drupal::config('system.site');
  $variables['site_name'] = $site_config->get('name');
  $variables['site_slogan'] = $site_config->get('slogan');

  // logo needs to be placed within specified folder
  $variables['logopath'] = \Drupal::service('file_url_generator')->generateString(theme_get_setting('logo.url'));
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();

  $host = \Drupal::request()->getSchemeAndHttpHost();
  $variables['host'] = $host;

  // Hero section from Home Slider content type (front page only).
  if (!empty($variables['is_front'])) {
    $variables['hero_slides'] = [];
    try {
      $storage = \Drupal::entityTypeManager()->getStorage('node');
      $ids = $storage->getQuery()
        ->accessCheck(TRUE)
        ->condition('type', 'home_slider')
        ->condition('status', 1)
        ->sort('created', 'DESC')
        ->execute();
      if (!empty($ids)) {
        $nodes = $storage->loadMultiple($ids);
        $file_url_generator = \Drupal::service('file_url_generator');
        /** @var \Drupal\node\NodeInterface $node */
        foreach ($nodes as $node) {
          $variables['#cache']['tags'][] = 'node:' . $node->id();
          $slide = [
            'title' => $node->getTitle(),
            'title_2' => $node->hasField('field_home_slider_title_2') && !$node->get('field_home_slider_title_2')->isEmpty()
              ? $node->get('field_home_slider_title_2')->value
              : '',
            'subtitle' => $node->hasField('field_home_slider_subtitle') && !$node->get('field_home_slider_subtitle')->isEmpty()
              ? $node->get('field_home_slider_subtitle')->value
              : '',
            'subtitle_2' => $node->hasField('field_home_slider_subtitle_2') && !$node->get('field_home_slider_subtitle_2')->isEmpty()
              ? $node->get('field_home_slider_subtitle_2')->value
              : '',
          ];
          if ($node->hasField('field_home_slider_image') && !$node->get('field_home_slider_image')->isEmpty()) {
            $file = $node->get('field_home_slider_image')->entity;
            if ($file && $file->getFileUri()) {
              $slide['image_url'] = $file_url_generator->generateAbsoluteString($file->getFileUri());
            }
          }
          if (!empty($slide['image_url']) || !empty($slide['title']) || $slide['title_2'] !== '' || $slide['subtitle'] !== '' || $slide['subtitle_2'] !== '') {
            $variables['hero_slides'][] = $slide;
          }
        }
      }
    } catch (\Exception $e) {
      \Drupal::logger('guinea')->warning('Hero slides load failed: @message', ['@message' => $e->getMessage()]);
    }
    $variables['#attached']['library'][] = 'guinea/hero-slider';
  }

  //===============for Mon Dashboard Page  =================================

  $current_path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);

  if ($alias === '/secure-dashboard') {
    $variables['data_manager_url'] = function_exists('resolveSecureDashboardDataManagerUrl')
      ? resolveSecureDashboardDataManagerUrl()
      : rtrim($host, '/') . '/datamanager/Login/#';
    $current_user = \Drupal::currentUser();
    $roles = $current_user->getRoles();
    $variables['hide_other_icons'] = (in_array('dm_data_reporter', $roles) || in_array('dm_data_reviewer', $roles));
    $variables['#cache']['contexts'][] = 'user';
    $variables['#cache']['contexts'][] = 'languages:language_interface';
  }

  if ($alias === '/monitoring-dashboard') {
    $variables['#attached']['library'][] = 'guinea/mon-dashboard';

    $app_url = isset($_ENV['APP_URL']) ? trim($_ENV['APP_URL']) : '';
    $api_url = $app_url . '/monservice/api/v1/GLOBAL/fr/readDashboardPlanStats';
    //$api_url = 'https://guinea.dataforall.org/monservice/api/v1/GLOBAL/fr/readDashboardPlanStats';

    $client = \Drupal::httpClient();
    try {
      $response = $client->get($api_url);
      $data = json_decode($response->getBody(), true);
      //dd($data);

      // Extract the parts we want
      $indScore = $data['data']['indScore'] ?? [];
      $actStatus = $data['data']['actStatus'] ?? [];
      $financialData = $data['data']['financialData'] ?? [];

      // Pass data to Twig
      $variables['ind_score'] = $indScore;
      $variables['act_status'] = $actStatus;
      $variables['financial_data'] = $financialData;

      // Pass data to JS via drupalSettings
      $settings = [
        'indScore' => $indScore,
        'actStatus' => $actStatus,
        'financialData' => $financialData,
      ];
      //$variables['#attached']['library'][] = 'guinea/mon-dashboard'; // defined in guinea.libraries.yml
      $variables['#attached']['drupalSettings']['guinea'] = $settings;
    } catch (\Exception $e) {
      \Drupal::logger('guinea')->error('API call failed: @message', ['@message' => $e->getMessage()]);
    }
  }
  //========================  For Mon Dashboard Page ====================================

  //========================  For DFA Help Settings =====================================
  // Pass DFA Help settings from .env to JavaScript
  $dfa_help_url = isset($_ENV['DFA_HELP_URL']) ? trim($_ENV['DFA_HELP_URL']) : '';
  $dfa_help_enabled = isset($_ENV['IS_DFA_HELP_ENABLED']) ? trim($_ENV['IS_DFA_HELP_ENABLED']) : 'false';

  // Debug logging (remove after testing)
  if (empty($dfa_help_url)) {
    \Drupal::logger('guinea')->warning('DFA_HELP_URL is empty or not set in .env file');
  }
  if (empty($dfa_help_enabled)) {
    \Drupal::logger('guinea')->warning('IS_DFA_HELP_ENABLED is empty or not set in .env file');
  }

  if (!isset($variables['#attached']['drupalSettings']['guinea'])) {
    $variables['#attached']['drupalSettings']['guinea'] = [];
  }
  $variables['#attached']['drupalSettings']['guinea']['DFA_HELP_URL'] = $dfa_help_url;
  $variables['#attached']['drupalSettings']['guinea']['IS_DFA_HELP_ENABLED'] = $dfa_help_enabled;

  //========================  For DFA Help Settings ===============================================
}


