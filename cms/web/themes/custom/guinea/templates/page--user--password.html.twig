{% include directory ~ '/templates/header.html.twig' %}

<div class="outer-section" id="user_Password">
	<div class="inner-section">
		<div class="login-banner password-reset-banner">
			<div class="login-wallpaper" aria-hidden="true">
				<img src="{{ base_path }}{{ directory }}/img/login_page.jpeg" alt="">
				<div class="over-circle"></div>
			</div>
			<div class="login-form password-reset-form-panel{% if password_mail_sent %} is-success{% endif %}">
				{% if password_mail_sent %}
					<div class="messages messages--status password-mail-sent" role="status" aria-live="polite">
						<span class="password-mail-sent-icon" aria-hidden="true">&#10003;</span>
						<div class="password-mail-sent-content">
							<strong>{{ 'E-mail envoye avec succes'|t }}</strong>
							<span>{{ 'Consultez votre boite de reception (et vos spams) pour reinitialiser votre mot de passe.'|t }}</span>
						</div>
					</div>
					<div class="password-mail-sent-actions">
						<a class="password-mail-sent-login-btn" href="{{ path('user.login') }}">{{ 'Retour a la connexion'|t }}</a>
						<a class="password-mail-sent-resend-btn" href="{{ path('user.pass') }}">{{ 'Renvoyer un e-mail'|t }}</a>
					</div>
				{% else %}
					{{ page.content }}
					<p class="password-back-to-login">
						<a href="{{ path('user.login') }}">{{ 'Retour à la connexion'|t }}</a>
					</p>
				{% endif %}
			</div>
		</div>
	</div>
</div>

{% include directory ~ '/templates/footer.html.twig' %}
