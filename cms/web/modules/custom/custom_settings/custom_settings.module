/**
 * Returns the user mail formatter (instantiated directly, no container service).
 */
function custom_settings_user_mail_formatter(): UserMailFormatter {
  static $formatter;
  if (!isset($formatter)) {
    $formatter = new UserMailFormatter(
      \Drupal::configFactory(),
      \Drupal::languageManager(),
      \Drupal::service('renderer'),
    );
  }
  return $formatter;
}

/**
 * Implements hook_preprocess_page().
 */
function custom_settings_preprocess_page(&$variables)
{
  $request = \Drupal::request();
  $route_name = \Drupal::routeMatch()->getRouteName();
  $mail_sent = $request->query->get('mail_sent');

  $variables['password_mail_sent'] = ($route_name === 'user.pass' && $mail_sent === '1');
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function custom_settings_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'entity.user.edit_form') {
    $request = \Drupal::request();
    $token = $request->query->get('pass-reset-token');

    if ($token !== NULL && $token !== '') {
      $suggestions[] = 'page__user__password_reset';
    }
  }
}


