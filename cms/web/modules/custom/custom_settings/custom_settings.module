/**
 * Implements hook_mail_alter().
 */


function custom_settings_mail_alter(&$message): void {
  if ($message['module'] !== 'user' || empty($message['params']['account'])) {
    return;
  }

  // Cancel sending the 'status_activated' email.
  if ($message['key'] === 'status_activated') {
    $message['send'] = FALSE;
    return;
  }

  /** @var \Drupal\custom_settings\Mail\UserMailFormatter $formatter */
  $formatter = custom_settings_user_mail_formatter();
  if (!$formatter->supports($message['key'])) {
    return;
  }

  $build = $formatter->build($message['key'], $message['params']['account'], $message['langcode']);
  if (!$build) {
    return;
  }

  $message['subject'] = $build['subject'];
  $message['body'] = [$build['body']];
  $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed';
  $message['headers']['Content-Transfer-Encoding'] = '8Bit';
  $from_name = 'Plateforme SAMA';
  $from_email = '';
  if (!empty($message['from'])) {
    if (preg_match('/<([^>]+)>/', (string) $message['from'], $matches)) {
      $from_email = trim($matches[1]);
    }
    elseif (filter_var((string) $message['from'], FILTER_VALIDATE_EMAIL)) {
      $from_email = (string) $message['from'];
    }
  }
  if ($from_email === '') {
    $from_email = (string) \Drupal::config('system.site')->get('mail');
  }
  if ($from_email !== '') {
    $message['from'] = sprintf('%s <%s>', $from_name, $from_email);
    $message['headers']['From'] = $message['from'];
  }
}


/**
 * Implements hook_form_alter() for adding csrf token to login and register form.
 */
function custom_settings_form_alter(&$form, FormStateInterface $form_state, $form_id)
{
    // if (in_array($form_id, ['user_login_form', 'user_register_form'])) {
    //     // Add CSRF token hidden field
    //     $form['csrf_token'] = [
    //         '#type' => 'hidden',
    //         '#value' => \Drupal::service('csrf_token')->get('user_form_csrf_protection'),
    //     ];

    //     // Attach a validation handler
    //     $form['#validate'][] = 'custom_settings_validate_csrf_token';
    // }
  if ($form_id === 'user_pass') {
    $form['#submit'] = $form['#submit'] ?? [];
    $form['#submit'][] = 'custom_settings_user_pass_submit_redirect';
  }

  if ($form_id === 'user_register_form') {
    $form['#validate'][] = 'custom_settings_user_register_clean_messages_validate';

    // Remove novalidate attribute to enable browser's native HTML5 validation.
    unset($form['#attributes']['novalidate']);

    // Make First name required.
    if (isset($form['field_name'])) {
      $form['field_name']['#required'] = TRUE;
      if (isset($form['field_name']['widget'][0]['value'])) {
        $form['field_name']['widget'][0]['value']['#required'] = TRUE;
      }
    }
  }

  if ($form_id === 'user_pass_reset') {
    if (isset($form['message']['#markup'])) {
      $form['message']['#markup'] = preg_replace('/\s*(qui expirera le|and will expire on)\s*<em class="placeholder">.*?<\/em>/ui', '', $form['message']['#markup']);
    }
  }

  // Use a clearer destructive action label on user edit forms.
  if (in_array($form_id, ['user_form', 'user_profile_form', 'user_user_form'], TRUE) && isset($form['actions']) && is_array($form['actions'])) {
    foreach ($form['actions'] as &$action) {
      if (!is_array($action)) {
        continue;
      }
      $title = (string) ($action['#title'] ?? '');
      $value = (string) ($action['#value'] ?? '');
      $is_cancel_account = str_contains(mb_strtolower($title), 'annuler le compte')
        || str_contains(mb_strtolower($value), 'annuler le compte')
        || str_contains(mb_strtolower($title), 'cancel account')
        || str_contains(mb_strtolower($value), 'cancel account');
      if ($is_cancel_account) {
        $action['#title'] = t('Supprimer le compte');
        if (isset($action['#value'])) {
          $action['#value'] = t('Supprimer le compte');
        }
      }
    }
    unset($action);
  }
}

/**
 * Keeps password reset users on the same page after submit.
 */
function custom_settings_user_pass_submit_redirect(array &$form, FormStateInterface $form_state): void {
  // Preserve validation errors; only change redirect when submit succeeded.
  if ($form_state->hasAnyErrors()) {
    return;
  }

  $form_state->setRedirect('user.pass', [], [
    'query' => [
      'mail_sent' => 1,
    ],
  ]);
}

