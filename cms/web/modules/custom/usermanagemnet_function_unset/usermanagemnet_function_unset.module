function assosialteWorkspaceUser(array $params): bool
{
  $host = isset($_ENV['APP_URL']) ? trim($_ENV['APP_URL']) : '';
  $status = false;

  $token = getApiToken();
  if (!empty($token)) {
    $reqHdrs[] = 'AuthorizationToken: ' . $token;
    $ntwrkResponse = doCurlPostRequest($host . MONITORING_CORE_URL . '/' . API_ASSOSIATE_WORKSPACE, $params, $reqHdrs);

    // Decode the response
    $decodeResp = json_decode($ntwrkResponse, true);

    if (!empty($decodeResp['success']) && $decodeResp['success'] === true) {
      $status = true;
    }
  }
  return $status;
}




/**
 * Api function for deleteuser
 */
function deleteUser(array $params): bool
{
  // global $base_url;
  //$base_url='https://tunisia.dataforall.org';
  $base_url = isset($_ENV['APP_URL']) ? trim($_ENV['APP_URL']) : '';

  $host = $base_url;

  $status = false;
  $token = getApiToken();
  if (!empty($token)) {
    $reqHdrs[] = 'AuthorizationToken: ' . $token;
    $ntwrkResponse = doCurlPostRequest($host . MONITORING_CORE_URL . '/' . API_DELETE_USER, $params, $reqHdrs);
    $decodeResp = json_decode($ntwrkResponse, 1);
    if (!empty($decodeResp['success']) && $decodeResp['success'] === true) {
      $status = true;
    } else {
      $status = false;
    }
  } else {
    $status = false;
  }
  return $status;
}


function usermanagemnet_function_unset_form_user_pass_alter(&$form, FormStateInterface $form_state, $form_id)
{
  // Add uep validation handler.
  $form['#validate'][] = 'user_pass_validate';
}


/**
 * Overrides user_pass_validate() found in user.pages.inc.
 */
function user_pass_validate($form, FormStateInterface $form_state)
{
  if ($form_state->getValue('name') == '') {
    $form_state->setErrorByName('name', ' Username or email address field is required.');
  } else {
    $input = trim($form_state->getValue('name'));
    // Access check would hide users from anonymous; this matches credential lookup.
    // Match username or email (same as core user password behavior).
    $query = \Drupal::entityQuery('user')
      ->accessCheck(FALSE)
      ->range(0, 1);
    $group = $query->orConditionGroup()
      ->condition('name', $input)
      ->condition('mail', $input);
    if (strpos($input, '@') !== FALSE) {
      // Also match normalized form so stored address casing can differ from input.
      $group->condition('mail', mb_strtolower($input));
    }
    $ids = $query->condition($group)->execute();

    if (empty($ids)) {
      $form_state->clearErrors();
      $form_state->setErrorByName('name', 'Account not found');
    }
  }
}


function usermanagemnet_function_unset_preprocess_html(&$variables)
{
  $variables['attributes']['class'][] = 'hide-confirmation';
}
