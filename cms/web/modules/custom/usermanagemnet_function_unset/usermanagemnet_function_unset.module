/*
 * the extra submit handler that persist the user management data filter value in database
 */
function sandbox_exposed_form_submit($form, \Drupal\Core\Form\FormStateInterface $form_state)
{
  $usercurrent = User::load(\Drupal::currentUser()->id());
  $user_filter_value = $usercurrent->get('field_user_filter_value')->value;
  $base_url = Url::fromUri('internal:/')->setAbsolute()->toString();
  $url = $base_url . "/user-administration" . $user_filter_value;
  $response = new Symfony\Component\HttpFoundation\RedirectResponse($url);
  $response->send();
  return;
}


function usermanagemnet_function_unset_views_query_alter(Drupal\views\ViewExecutable $view, Drupal\views\Plugin\views\query\Sql $query)
{
  if ($view->id() == 'user_management') {
    $current_url = Url::fromRoute('<current>');
    $path = $current_url->toString();
    $current_uri = \Drupal::request()->getRequestUri();
    $filter_url = explode($path, $current_uri);

    // alter view query to display record properly
    $usercurrent = User::load(\Drupal::currentUser()->id());
    $user_worspaces = [];
    $userWsIdRes = $usercurrent->get('field_workspaces')->getValue();
    foreach ($userWsIdRes as $usrWsIds) {
      $user_worspaces[] = $usrWsIds['target_id'];
    }
    $user_id = $usercurrent->get('uid')->value;
    $connection = Database::getConnection();
    $myrole = $connection->query("SELECT roles_target_id FROM {user__roles} WHERE entity_id = :entity_ids", [':entity_ids' => $user_id])->fetchField();
    if (($myrole == 'country_admin')) {
      $configuration = [
        'left_table' => 'users_field_data',
        'left_field' => 'uid',
        'table' => 'user__field_workspaces',
        'field' => 'entity_id',
        'adjusted' => TRUE,
      ];
      $user_worspaces_id_str = join("','", $user_worspaces);
      $join = \Drupal::service('plugin.manager.views.join')->createInstance('standard', $configuration);
      $query->addRelationship('user__field_workspaces', $join, 'users_field_data');
      $query->addWhereExpression(0, "FIND_IN_SET('" . $user_worspaces_id_str . "', user__field_workspaces.field_workspaces_target_id) ");
      $query->addWhere(1, 'users_field_data.uid', $user_id, '!=');
    }

    if (!empty($filter_url[1])) {
      $extraUrl = trim($filter_url[1]);
      $search = 'format=csv';
      if (strpos($extraUrl, $search) !== false) {
        //echo 'do nothing';
      } else {
        //$usercurrent = User::load(\Drupal::currentUser()->id());
        //$usercurrent->set('field_user_filter_value', $extraUrl);
        $usercurrent->save();
      }
    }

    // The crucial part! Save the $user object, else changes won't persist.
  }
}


/*
* Submit handler for user edit form
*/

function check_data_saved_in_dfa($form, FormStateInterface $form_state)
{
  $data = array();
  $values = \Drupal::request()->request->all();
  $uid = $form_state->getValue('uid');
  $name = $form_state->getValue('name');
  $mail = $form_state->getValue('mail');

  $route_user = \Drupal::routeMatch()->getParameter('user');
  $current_user_id = ($route_user instanceof UserInterface) ? (int) $route_user->id() : 0;

  if ($current_user_id > 0) {
    $current_user_data = User::load($current_user_id);
    if ($current_user_data) {
      $username = $current_user_data->getAccountName();
      $email = $current_user_data->getEmail();
    }
    else {
      $username = $name;
      $email = $mail;
    }
  } else {
    $username = $name;
    $email = $mail;
  }

  $connection = Database::getConnection();
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $token = getApiToken();

  $user_roles = array('VIEWER');
  $roles_input = $values['roles'] ?? $form_state->getValue('roles');
  $selected_role = '';
  if (is_array($roles_input)) {
    $first_value = reset($roles_input);
    if (is_string($first_value) && $first_value !== '') {
      // Radios/selects may submit as array with the selected role as first value.
      $selected_role = $first_value;
    }
    else {
      // Checkbox-style role arrays may be keyed by role id with truthy values.
      foreach ($roles_input as $rid => $enabled) {
        if ($enabled && !in_array($rid, ['authenticated', 'anonymous'], TRUE)) {
          $selected_role = (string) $rid;
          break;
        }
      }
    }
  }
  elseif (is_string($roles_input)) {
    $selected_role = $roles_input;
  }

  if ($selected_role == 'country_admin') {
    // $selWsIds = explode(',', $values['field_workspaces'][0]['value']);
  } else {
    // $selWsIds = array('ALL');
  }

  $usrArr = ['first_name' => $values['field_name'][0]['value'], 'last_name' => $values['field_surname'][0]['value'], 'username' => $username, 'email' => $email, 'agency' => '', 'ws' => ['GLOBAL'], 'roles' => array('VIEWER')];

  $data = ['uid' => $uid, 'workspace' => 'GLOBAL', 'language' => $language, 'action' => 'create', 'User' => $usrArr];

  \Drupal::logger('api_data')->notice(json_encode($data));
  
  synUserToDatamanager($usrArr);

  $dfa_status = syncUserToServiceProvider($data, $token);
  if ($dfa_status['success'] !== true) {
    \Drupal::logger('api_params')->notice(json_encode($data));
    \Drupal::logger('api_response')->notice(json_encode($dfa_status));
  } else {
    \Drupal::logger('api_response_true_case')->notice(json_encode($dfa_status));

    $connection = Database::getConnection();
    $num_updated = $connection->update('user__field_sy')
      ->fields([
        'field_sy_value' => 1,
      ])
      ->condition('entity_id', $uid, '=')
      ->execute();

    /* End sync status field from 0 to 1 */

    if ($selected_role != '') {
      $usrArr = ['first_name' => $values['field_name'][0]['value'], 'last_name' => $values['field_surname'][0]['value'], 'username' => $username, 'email' => $email, 'agency' => '', 'ws' => ['GLOBAL'], 'roles' => array($selected_role)];
      // $usrArr = ['first_name' => 'aaaa', 'last_name' => 'ssss', 'username' => $email, 'email' => $email, 'agency' => '', 'ws' => ['GLOBAL'], 'roles' => array('VIEWER')];

      $data = ['uid' => $uid, 'workspace' => 'GLOBAL', 'language' => $language, 'action' => 'create', 'User' => $usrArr];

      $data = ['uid' => $uid, 'workspace' => 'GLOBAL', 'language' => $language, 'action' => 'create', 'User' => $usrArr];

      \Drupal::logger('api_data')->notice(json_encode($data));

      $dfa_status = syncUserToServiceProvider($data, $token);
      if ($dfa_status['success'] !== true) {
        \Drupal::logger('api_params')->notice(json_encode($data));
        \Drupal::logger('api_response')->notice(json_encode($dfa_status));

        if ($dfa_status['err']['msg'] != '') {
          $form_state->setErrorByName('name', $dfa_status['err']['msg']);
        } else {
          $form_state->setErrorByName('name', $dfa_status['err']['code']);
        }
      }
    }
  }
}



/* 
* Submit handler of call api for user delete
*/
function validateUser($currUserId, $currUserRoles, $currUserWsIdArr, $selUserId, $selUserWsIdArr, $action)
{
  $status = false;
  // global admin can do anything
  if (in_array("global_admin", $currUserRoles) !== false) {
    $status = true;
  } else {
    // country admin can update only if belongs to one workspace only
    if (in_array("country_admin", $currUserRoles) !== false) {
      // cannot delete if more than one ws associated
      if ($action == 'delete' && sizeof($selUserWsIdArr) > 1) {
        $status = false;
      } else if ($action == 'delete' && $currUserId == $selUserId) {
        $status = false;
      } else {
        $commWsIdArr = array_intersect($currUserWsIdArr, $selUserWsIdArr);
        print_r($commWsIdArr);
        if (sizeof($commWsIdArr) > 0 && sizeof($commWsIdArr) < 2) {
          $status = true;
        }
      }
    } else {
      if ($action == 'update' && $currUserId == $selUserId) {
        $status = true;
      }
    }
  }
  return $status;
}


/*
* This handler is calling for delete user programmiticlly
*/

function usermanagemnet_function_unset_custom_user_delete()
{
  $status = false;
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $route_user = \Drupal::routeMatch()->getParameter('user');
  $delete_user_id = ($route_user instanceof UserInterface) ? (int) $route_user->id() : 0;
  if ($delete_user_id <= 0) {
    \Drupal::logger('delete_user')->error('Delete requested without a valid route user.');
    return;
  }
  $deleted_user = User::load($delete_user_id);
  if (!$deleted_user) {
    \Drupal::logger('delete_user')->error('Delete requested for missing user id: @uid', ['@uid' => $delete_user_id]);
    return;
  }
  $current_user = User::load(\Drupal::currentUser()->id());
  $deleted_un = $deleted_user->getAccountName();
  $current_un = $current_user->getAccountName();

  $data = ['action' => 'delete', 'workspace' => 'GLOBAL', 'username' => $deleted_un, 'language' => $language, 'logged_in_username' => $current_un];

  \Drupal::logger('deleted_user')->notice(json_encode($data));

  $api_response = deleteUser($data);
  if ($api_response === true) {
    $deleted_user->delete();
  } else {
    \Drupal::logger('delete_user')->error('Remote delete failed: ' . json_encode($api_response));
  }
}


/**
 * Api function for createuser
 */

function syncUserToServiceProvider(array $params, $token)
{
  // global $base_url;
  //$base_url='https://tunisia.dataforall.org';
  $base_url = isset($_ENV['APP_URL']) ? trim($_ENV['APP_URL']) : '';

  $host  =  $base_url;

  if (empty($token)) {
    $api_token = getApiToken();
  } else {
    $api_token = $token;
  }

  $reqHdrs[] = 'AuthorizationToken: ' . $api_token;

  \Drupal::logger('api_debug')->notice('Calling URL: ' . $host . MONITORING_CORE_URL . '/' . API_CREATE_USER);

  \Drupal::logger('api_debug')->notice('Request Headers: ' . json_encode($reqHdrs));
  \Drupal::logger('api_debug')->notice('Request Params: ' . json_encode($params));

  $ntwrkResponse = doCurlPostRequest($host . MONITORING_CORE_URL . '/' . API_CREATE_USER, $params, $reqHdrs);

  if ($ntwrkResponse === false || $ntwrkResponse === null) {
    \Drupal::logger('api_debug')->error('Curl returned NULL or FALSE');
  } else {
    \Drupal::logger('api_debug')->notice('Raw Curl Response: ' . $ntwrkResponse);
  }

  \Drupal::logger('debug_constants')->notice('API_CREATE_USER: ' . API_CREATE_USER);
  \Drupal::logger('debug_constants')->notice('MONITORING_CORE_URL: ' . MONITORING_CORE_URL);
  \Drupal::logger('api_debug')->notice('Headers: ' . json_encode($reqHdrs));
  \Drupal::logger('api_debug')->notice('Params: ' . json_encode($params));
  \Drupal::logger('openid_api_response_true_case')->notice(json_encode($ntwrkResponse));

  $ntwrkdecode = json_decode($ntwrkResponse, true);

  return $ntwrkdecode;
}


/**
 * Api function for createuser in datamanager
 */

function synUserToDatamanager($user_data)
{
  $config = \Drupal::config('metadata.adminsettings');
  $api_url = $config->get('api_url');
  if (empty($api_url)) {
    return;
  }
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $client = new \GuzzleHttp\Client();

  $url = $api_url . 'saveusr';
  $usrArr = [
    'lang' => $language,
    'name' => $user_data['first_name'],
    'status' => 1,
    'username' => $user_data['username'],
    'email' => $user_data['email'],
    'roleAction' => 'add',
    'roles' => ['TEMPLATE']
  ];

  $response = $client->request('POST', $url, [
    'form_params' => [
      'usrArr' => [$usrArr],
      'dbId' => $config->get('api_db_id'),
    ],
  ]);

  $body = $response->getBody()->getContents();
  $body = json_decode($body, true);

  if ($body['success'] == true) {
    \Drupal::logger('datamanager_user_entry')->notice('data inserted: ' . json_encode($user_data));
  } else {
    \Drupal::logger('datamanager_user_entry')->notice(json_encode($body['error']));
  }
}


