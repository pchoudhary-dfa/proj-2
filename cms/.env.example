# Database Configuration
DB_NAME=guinea
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_DRIVER=mysql

# Drupal Configuration
DRUPAL_TRUSTED_HOST_PATTERNS=^guinea$,^guinea\.localhost$,^localhost$

# Development Settings
DRUPAL_ENVIRONMENT=development

# Config Sync Directory
DRUPAL_CONFIG_SYNC_DIRECTORY=sites/default/files/config/sync

# Database Isolation Level (optional)
DB_ISOLATION_LEVEL="READ COMMITTED"

# Public Files Directory (uploaded files)
DRUPAL_FILE_PUBLIC_PATH=sites/default/files

# Drupal hash salt (required). Generate with: php -r "echo bin2hex(random_bytes(48));"
DRUPAL_HASH_SALT=
